# 「안녕, 동화」 환경 변수 예시
#
# 실제 배포에서는 이 파일에 키를 넣지 않습니다.
# 키는 GitHub 저장소의 Settings → Secrets and variables → Actions 에
#   - Secret:   GEMINI_API_KEY
#   - Variable: VITE_GEMINI_MODEL (선택)
# 로 등록하면 배포 빌드에 자동 주입됩니다.
#
# 아래는 로컬 개발(npm run dev)에서 AI를 시험할 때만 쓰는 예시입니다.
# 이 파일을 복사해 `.env.local`로 만들고 값을 채우세요. (.env.local 은 커밋되지 않습니다)

# Gemini API 키 (Google AI Studio에서 발급)
VITE_GEMINI_API_KEY=

# 모델 폴백 체인 (선택, 쉼표로 구분). 앞에서부터 시도하고 실패하면 다음 모델로 넘어갑니다.
# 비워 두면 아래 기본 체인이 사용됩니다.
VITE_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash,gemini-2.5-flash-lite

# 단일 모델만 쓰고 싶으면 위 VITE_GEMINI_MODELS 대신 이 값을 설정 (선택)
# VITE_GEMINI_MODEL=gemini-2.5-flash
